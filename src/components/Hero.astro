---
import { getImage, Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { heroImages, heroImageWidths } from '../data/hero';
import type { ImageMetadata } from 'astro';

async function makeSourceSet(image: ImageMetadata, widths: number[]) {
  const outputWidths = [...new Set(widths.map((width) => Math.min(width, image.width)))];
  const images = await Promise.all(outputWidths.map(async (width) => {
    const optimized = await getImage({ src: image, width, format: 'webp', quality: 95 });
    return `${optimized.src} ${width}w`;
  }));
  return images.join(', ');
}

const [mobileSourceSet, tabletSourceSet] = await Promise.all([
  makeSourceSet(heroImages.mobile, heroImageWidths.mobile),
  makeSourceSet(heroImages.tablet, heroImageWidths.tablet),
]);
const desktopWidths = [...new Set(heroImageWidths.desktop.map((width) => Math.min(width, heroImages.desktop.width)))];
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">宮崎県都城市のメンズエステ Reposer〜ルポゼ〜</h1>
  <div class="hero-artwork">
    <picture class="hero-picture">
      <source media="(max-width: 760px)" srcset={mobileSourceSet} sizes="100vw" width={heroImages.mobile.width} height={heroImages.mobile.height} />
      <source media="(max-width: 1100px)" srcset={tabletSourceSet} sizes="100vw" width={heroImages.tablet.width} height={heroImages.tablet.height} />
      <Image src={heroImages.desktop} alt="Reposer〜ルポゼ〜。特別な癒しと安らぎを…。シャンパンカラーのサロンイメージバナー" widths={desktopWidths} sizes="100vw" format="webp" quality={95} loading="eager" fetchpriority="high" decoding="async" />
    </picture>
  </div>
  <div class="hero-panel">
    <div class="hero-panel-inner">
      <div class="hero-intro"><p class="hero-area">宮崎県都城市のメンズエステ</p><p class="hero-status">完全予約制<span aria-hidden="true">／</span>{site.holiday}</p></div>
      <div class="hero-actions">
        <a class="hero-book hero-book-web" href={site.webUrl} target="_blank" rel="noopener noreferrer"><Icon name="calendar" size={21} /><span>WEB予約<span class="hero-book-sub">エステ魂</span></span><Icon name="arrow" size={20} /><span class="sr-only">（外部サイト・新しいタブ）</span></a>
        <a class="hero-book hero-book-line" href={site.lineUrl} target="_blank" rel="noopener noreferrer"><Icon name="line" size={21} /><span>LINEで予約</span><Icon name="arrow" size={20} /><span class="sr-only">（新しいタブ）</span></a>
      </div>
      <p class="hero-reception"><span>受付時間</span><strong>{site.receptionDisplay}</strong><span>{site.receptionNote}</span></p>
    </div>
    <a class="hero-discover" href="#concept">ルポゼについて知る<Icon name="arrow" size={16} /></a>
  </div>
</section>
